[Application]
FileLogger\Age=1
FileLogger\AgeType=1
FileLogger\Backup=true
FileLogger\DeleteOld=true
FileLogger\Enabled=true
FileLogger\MaxSizeBytes=66560
FileLogger\Path=/config/qBittorrent/logs

[AutoRun]
enabled=false
program=

[BitTorrent]
Session\AddTorrentStopped=false
Session\AlternativeGlobalDLSpeedLimit=500
Session\Categories="{\"prowlarr\":{\"name\":\"prowlarr\",\"save_path\":\"\"},\"radarr\":{\"name\":\"radarr\",\"save_path\":\"/downloads/movies/complete\"},\"series\":{\"name\":\"series\",\"save_path\":\"/downloads/series/complete\"},\"sonarr\":{\"name\":\"sonarr\",\"save_path\":\"/downloads/series/complete\"},\"tv-sonarr\":{\"name\":\"tv-sonarr\",\"save_path\":\"/downloads/series/complete\"}}"
Session\DefaultSavePath=/downloads/
Session\ExcludedFileNames=
Session\GlobalMaxInactiveSeedingMinutes=10
Session\GlobalMaxSeedingMinutes=10
Session\GlobalUPSpeedLimit=10
Session\Port=6881
Session\QueueingSystemEnabled=false
Session\SSL\Port=7103
Session\ShareLimitAction=Stop
Session\TempPath=/downloads/
Session\UseAlternativeGlobalSpeedLimit=false

[Categories]
prowlarr\save_path=
radarr\save_path=/downloads/movies/complete
series\save_path=/downloads/series/complete
sonarr\save_path=/downloads/series/complete
tv-sonarr\save_path=/downloads/series/complete

[Core]
AutoDeleteAddedTorrentFile=Never

[LegalNotice]
Accepted=true

[Meta]
MigrationVersion=8

[Network]
PortForwardingEnabled=false
Proxy\HostnameLookupEnabled=false
Proxy\Profiles\BitTorrent=true
Proxy\Profiles\Misc=true
Proxy\Profiles\RSS=true

[Preferences]
Connection\PortRangeMin=6881
Connection\UPnP=false
Downloads\SavePath=/downloads/
Downloads\TempPath=/downloads/
General\Locale=en
MailNotification\req_auth=true
WebUI\Address=*
WebUI\AuthSubnetWhitelist=0.0.0.0/0
WebUI\AuthSubnetWhitelistEnabled=true
WebUI\CSRFProtection=false
WebUI\HostHeaderValidation=false
WebUI\LocalHostAuth=false
WebUI\ServerDomains=*

[RSS]
AutoDownloader\DownloadRepacks=true
AutoDownloader\SmartEpisodeFilter=s(\\d+)e(\\d+), (\\d+)x(\\d+), "(\\d{4}[.\\-]\\d{1,2}[.\\-]\\d{4})", "(\\d{1,2}[.\\-]\\d{1,2}[.\\-]\\d{4})"
