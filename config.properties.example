[server]
port = 3000

[paths]
media_dir = ./media
downloads_dir = ./downloads

[podman]
network = media_center_net

[automation]
watchlist_sync_minutes = 5
auto_update_enabled = true
watched_media_action = keep
disk_wake_policy = media_only
music_start_slskd = true
delete_disliked_music = true
sync_music_ratings = true
# Optional: enable direct Aurral Favorites/Feedback & ListenBrainz Love/Hate sync from Plexamp ratings
# aurral_user_api_key =
# listenbrainz_token =
