# Media & Downloads directories
/media/
/downloads/

# All service runtime configs, data, databases, and logs
**/config/
**/data/
**/logs/
**/cache/
*.db
*.db-shm
*.db-wal
*.log
*.pid
*.conf
*.yml
*.yaml
!services/**/podman-compose.yml

# Local environment, runtime state/PIDs & properties files
config.properties
disk_config.json
/run/
*.running
media_external_stub/
.env
**/.env
**/.env.local
!**/.env.example

# Dynamically generated OS Launchers & Stoppers (under scripts/)
/scripts/*.bat
/scripts/*.sh
start.bat
start.sh
start_*.bat
start_*.sh
stop_*.bat
stop_*.sh
stop.bat
stop.sh
status.bat
status.sh

# Python cache & virtual environments
__pycache__/
*.pyc
.venv/
env/
venv/

# IDE & Tool directories
.idea/
.vscode/
.agents/
